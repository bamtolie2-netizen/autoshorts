# 이 파일을 .env 로 복사한 뒤 실제 값으로 채워주세요.
# .env 파일은 절대 GitHub 등에 올리지 마세요 (.gitignore에 포함되어 있음)

ANTHROPIC_API_KEY=sk-ant-여기에-본인-키
PEXELS_API_KEY=여기에-본인-Pexels-키

# private(비공개, 기본값/안전) / unlisted(링크공개) / public(전체공개)
YOUTUBE_PRIVACY_STATUS=private

# AI 생성 콘텐츠임을 투명하게 공개할지 여부 (권장: true)
DISCLOSE_SYNTHETIC_MEDIA=true
